# Firebase (copier depuis la console Firebase > Paramètres du projet)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# SumUp (depuis https://developer.sumup.com > Applications)
# Ces clés vivent côté Cloud Functions (functions/.env), jamais côté client
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_REDIRECT_URI=

# URL de la fonction sumupAuthUrl une fois déployée (affiche le bouton "Connecter SumUp")
# Trouvable dans la console Firebase > Functions, après le déploiement
VITE_SUMUP_CONNECT_URL=

# Google Agenda (depuis https://console.cloud.google.com > API et services > Identifiants)
# Client ID OAuth 2.0 de type "Application Web"
VITE_GOOGLE_CLIENT_ID=
