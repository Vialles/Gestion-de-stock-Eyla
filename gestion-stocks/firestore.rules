rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /produits/{doc} {
      allow read, write: if request.auth != null;
    }
    match /achats/{doc} {
      allow read, write: if request.auth != null;
    }
    match /ventes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /commandes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /integrations/{doc} {
      allow read, write: if false; // uniquement via Cloud Functions (admin SDK)
    }
  }
}
