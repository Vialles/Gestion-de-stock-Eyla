rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Auth anonyme requise, comme dans planning-menage.
    // À affiner si plusieurs utilisateurs distincts doivent être séparés.
    match /produits/{doc} {
      allow read, write: if request.auth != null;
    }
    match /achats/{doc} {
      allow read, write: if request.auth != null;
    }
    match /ventes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /integrations/{doc} {
      allow read, write: if false; // uniquement via Cloud Functions (admin SDK)
    }
  }
}
